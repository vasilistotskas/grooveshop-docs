{
  "name": "grooveshop-docs",
  "version": "1.2.39",
  "private": true,
  "description": "GrooveShop platform documentation: tenant-admin guide (el/en) and developer reference",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:sources": "node scripts/sync-sources.mjs",
    "dev": "pnpm sync:sources && vitepress dev",
    "build": "vitepress build && node scripts/postbuild.mjs",
    "build:full": "pnpm sync:sources && pnpm build",
    "preview": "vitepress preview",
    "check:admin": "node scripts/check-admin-prose.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "mermaid": "12.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.5.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "docs",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
